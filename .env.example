# Copy this file to ".env" and fill in your own values. Never upload .env to GitHub.

# Full connection string of your hosted PostgreSQL database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Websites allowed to call this API from a browser (comma separated, no spaces needed).
# Add your Netlify address when you connect the frontend in Activity 8.
CLIENT_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://your-frontend.netlify.app

# Optional: set to false only if your database does not use SSL (for example a local database)
# DATABASE_SSL=false

# Optional: your public API address, shown on the guide page
# PUBLIC_URL=https://your-backend.onrender.com
